# Copy to .env for local development (docker-compose provides these services).
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

# Comma-separated emails auto-promoted to admin on login/verify.
ADMIN_EMAILS=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/social_media
REDIS_URL=redis://localhost:6379/0
